  "item": [
    {
      "name": "Agency",
      "item": [
        {
          "name": "Create Agency (ADMIN/HR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "create"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"acme.agency@example.com\",\n  \"password\": \"Secret123\",\n  \"confirmPassword\": \"Secret123\",\n  \"name\": \"ACME Agency\",\n  \"phone\": \"+15551234567\"\n}"
            }
          }
        },
        {
          "name": "Nurse Join Agency (NURSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/{{agencyId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "{{agencyId}}", "join"]
            }
          }
        },
        {
          "name": "Get Agency Hospitals (AGENCY/HR/ADMIN)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/{{agencyId}}/hospitals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "{{agencyId}}", "hospitals"]
            }
          }
        },
        {
          "name": "Onboard Agency to Hospitals (ADMIN/HR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/{{agencyId}}/hospitals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "{{agencyId}}", "hospitals"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospitalIds\": [ {{hospitalId}} ]\n}"
            }
          }
        }
        ,
        {
          "name": "List Agencies (ADMIN/HR)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/list?includeHospitals=true&linkStatus=APPROVED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "list"],
              "query": [
                { "key": "includeHospitals", "value": "true" },
                { "key": "linkStatus", "value": "APPROVED" }
              ]
            }
          }
        },
        {
          "name": "Get Agencies by Hospital (ADMIN/HR/AGENCY)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/hospitals/{{hospitalId}}/agencies?status=APPROVED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "hospitals", "{{hospitalId}}", "agencies"],
              "query": [ { "key": "status", "value": "APPROVED" } ]
            }
          }
        }
      ]
    },
    {
      "name": "Blacklist",
      "item": [
        {
          "name": "Blacklist Agency for Hospital (ADMIN/HR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/{{agencyId}}/hospitals/{{hospitalId}}/blacklist",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "{{agencyId}}", "hospitals", "{{hospitalId}}", "blacklist"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reasonCategory\": \"NON_COMPLIANCE\",\n  \"reasonDetails\": \"Breach of shift coverage SLA twice in a month\"\n}"
            }
          }
        },
        {
          "name": "Restore Agency for Hospital (ADMIN/HR)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/{{agencyId}}/hospitals/{{hospitalId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "{{agencyId}}", "hospitals", "{{hospitalId}}", "restore"]
            }
          }
        },
        {
          "name": "Get Blacklisted Agencies by Hospital (ADMIN/HR)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/hospitals/{{hospitalId}}/blacklisted?q=conduct&from=2025-01-01&to=2025-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "hospitals", "{{hospitalId}}", "blacklisted"],
              "query": [
                { "key": "q", "value": "conduct" },
                { "key": "from", "value": "2025-01-01" },
                { "key": "to", "value": "2025-12-31" }
              ]
            }
          }
        },
        {
          "name": "Get Blacklisted Hospitals for Agency (AGENCY/HR/ADMIN)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/{{agencyId}}/blacklisted-hospitals?q=rate&from=2025-01-01&to=2025-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "{{agencyId}}", "blacklisted-hospitals"],
              "query": [
                { "key": "q", "value": "rate" },
                { "key": "from", "value": "2025-01-01" },
                { "key": "to", "value": "2025-12-31" }
              ]
            }
          }
        },
        {
          "name": "Get All Blacklisted Links (ADMIN/HR)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/agency/blacklisted?q=no%20show",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "agency", "blacklisted"],
              "query": [ { "key": "q", "value": "no show" } ]
            }
          }
        }
      ]
    },
